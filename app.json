{
  "expo": {
    "name": "Tarım Muhasebe",
    "slug": "ciftlik-takip",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tarimmuhasebe",
    "userInterfaceStyle": "light",
    "sdkVersion": "54.0.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ciftlik.takip"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.ciftlik.takip",
      "versionCode": 9
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "offlineMode": true,
      "eas": {
        "projectId": "33b03a4b-c52d-4794-a5e8-2ff6b94c2a2b"
      }
    }
  }
}
